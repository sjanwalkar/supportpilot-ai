# Never bake local dev state or secrets into the image.
.venv
__pycache__
*.pyc
.pytest_cache
.git
.gitignore

# Secrets — passed at runtime via docker-compose's env_file, never
# copied into the image itself (an image can end up pushed to a
# registry; a baked-in .env would leak API keys with it).
.env

# The local dev SQLite file — the container should start clean (or use
# a mounted volume, see docker-compose.yml), not ship whatever test
# data/tickets accumulated on your machine during development.
data/supportpilot.db

.DS_Store
*.egg-info
